<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Home Page</title>
    <link rel="stylesheet" href="../stylesheets/home.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap" rel="stylesheet">
</head>
<body>
    <div>
       
        <div class="parent-nav d-flex justify-content-around align-items-center">
            <div class="left">
             <a href="/campgrounds"><img src="../assets/campscape.png" alt=""></a>
             
            </div>
            <div class="right">
             <ul class="d-flex">
               <%   if(currentUser){   %>
                     <li><a href="/">Home</a></li>
                     <li><a href="/campgrounds">Campgrounds</a></li>
                     <li><a href="/logout">Logout</a></li>
                <%  } else { %>
                 <li><a href="/">Home</a></li>
                 <li><a href="/campgrounds">Campgrounds</a></li>
                 <li><a href="/login">Login</a></li>
                 <li><a href="/register">Register</a></li>
                <%  }  %>
               
                
             </ul>
            </div>
         </div>
         <div class="hero d-flex justify-content-around align-items-center  mx-auto ">    
            <div class="hero-left">
                <h1>Find your next adventure with <span>campverse.</span></h1>
                <p>Explore a variety of campgrounds for your next adventure, share your own experiences, leave reviews, and help others discover the best spots.</p>
                <a href="/campgrounds" class="custom-btn">Explore Campgrounds</a>
            </div>
            <div class="hero-right">
                <div class="wave-wrapper">
                    <img src="../assets/hero_img.png" alt="">
                </div>
            </div>
         </div>
    </div>


<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
<script src="/javascripts/validateForms.js"></script>
</body>
</html>