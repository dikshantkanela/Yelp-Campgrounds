<% layout('layouts/boilerplate')%>

<link rel="stylesheet" href="../stylesheets/login.css">
<!-- MAIN CONTAINER -->
<div class="container  d-flex justify-content-center align-items-center min-vh-100">
    <!-- LOGIN CONTAINER -->
    <div class="row  rounded-5 p-3 bg-white shadow box-area">
        <!-- LEFT IMAGE -->
        <div class="col-md-6 left-box rounded-4 d-flex justify-content-center align-items-center flex-column ">
            <div class="featured-image mb-3 ">
                <img class="img-fluid" style="width: 250px;" src="../assets/sign.png" alt="">
            </div>
            <p class="text-white fs-2" style="font-family:Verdana, Geneva, Tahoma, sans-serif;">Start Exploring</p>
            <small class="text-white text-wrap text-center" style="width: 17rem;">Join Campverse to discover campgrounds and review others to find the best spots!</small>
        </div>
        <!-- RIGHT FORM  -->
        <div class="col-md-6 right-box">
          <div class="row align-items-center">
            <div class="header-text mb-4">
                <h2>Register as a user</h2>
                <p>Welcome! Let’s get you registered.</p>
                <form action="/register" method="POST" class="validated-form" novalidate>
                    <div class="mb-3">
                        <input class="form-control form-control-lg bg-light fs-6" placeholder="Username" type="text" id="username" name="username" autofocus required>
                        <div class="valid-feedback">
                            Looks good!
                        </div>
                    </div>

                    <div class="mb-3">
                        <input class="form-control form-control-lg bg-light fs-6" placeholder="Email" type="email" id="email" name="email"  required>
                        <div class="valid-feedback">
                            Looks good!
                        </div>
                    </div>
                     
                    <div class="mb-4">
                        <input class="form-control form-control-lg bg-light fs-6" placeholder="Password" type="password" id="password" name="password" required>
                        <div class="valid-feedback">
                            Looks good!
                        </div>
                    </div>
                    <div class="input-group mb-4">
                        <button class="btn btn-primary btn-lg w-100 fs-6">Register</button>
                       </div>
                       <div class="row">
                        <small>Already have an account? <a href="/login">Login</a></small>
                       </div>
                </form>
             
            </div>
          </div>
        </div>
    </div>
</div>