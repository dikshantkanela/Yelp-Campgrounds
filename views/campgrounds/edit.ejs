<% layout("layouts/boilerplate.ejs") %>

<h1 class="text-center">Edit Campground</h1>
<div class="col-6 offset-3">
  <!-- SEND A PUT REQUEST TO THE /CAMPGROUNDS ROUTE SO THAT THE CAMPGROUND IS UPDATED -->
  <form action="/campgrounds/<%= campground._id %>?_method=PUT" method="POST" class="validated-form" novalidate enctype="multipart/form-data">
    <div class="mb-3">
      <label class="form-label" for="title">Enter Title:</label>
      <input class="form-control" id="title" value="<%= campground.title %>" type="text" name="campground[title]" required>
      <div class="invalid-feedback">
        Please give a location!
      </div>
      <div class="valid-feedback">
        Looks good!
      </div>
    </div>

    <div class="mb-3">
      <label class="form-label" for="location">Enter Location:</label>
      <input class="form-control" id="location" value="<%= campground.location %>" type="text" name="campground[location]" required>
      <div class="invalid-feedback">
        Please give a location!
      </div>
      <div class="valid-feedback">
        Looks good!
      </div>
    </div>

   
    <div class="mb-3">
      <label for="price">Campground Price:</label>
    </div>
    <div class="input-group mb-3">
      <span class="input-group-text" id="price-label">$</span>
      <input id="price" type="text" class="form-control" value="<%= campground.price %>" name="campground[price]" placeholder="0.0" aria-label="price" aria-describedby="price-label" required>
      <div class="invalid-feedback">
        Please give a location!
      </div>
      <div class="valid-feedback">
        Looks good!
      </div>
    </div>

    <div class="mb-3">
      <label class="form-label" for="description">Enter Description:</label>
      <textarea class="form-control" id="description" name="campground[description]" required><%= campground.description %></textarea>
      <div class="invalid-feedback">
        Please give a location!
      </div>
      <div class="valid-feedback">
        Looks good!
      </div>
    </div>
    <div class="input-group mb-3">
      <input type="file" multiple name="image" class="form-control" id="image">
      <label class="input-group-text" for="image">Upload</label>
    </div>
  <div class="mb-3">
   <% campground.images.forEach((img,index)=>{ %>
        <img src="<%= img.url %>" class="img-thumbnail" alt="">
        <div class="form-check-inline">
          <!-- THE KEY IN THE REQ.BODY WILL BE deleteImages(an array!!!) and VALUE WILL BE img.filename -->
          <input type="checkbox" id="image-<%=index%>" name="deleteImages[]" value="<%=img.filename%>" >
        </div>
        <label style="cursor: pointer;" for="image-<%=index%>">Delete?</label>
   <% }) %>
  </div>
    <div class="mb-3">
      <button class="btn btn-danger">Update Campground</button>
    </div>
  
    <a href="/campgrounds/<%= campground._id %>">Back to Campground</a>
  </form>
</div>
